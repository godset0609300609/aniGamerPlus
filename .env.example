# Shared secret for scheduler/api internal HTTP+WS auth.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANIGAMERPLUS_INTERNAL_SECRET=

# Redis password (Redis binds to the compose network with no auth by
# default otherwise). Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# Host uid/gid the backend containers run as (non-root). Must own the
# bind-mounted ./data, ./logs and ./bangumi directories before first start:
#   chown -R 1000:1000 data logs bangumi
# Only needs changing if your host user isn't uid 1000.
USER_UID=1000

# Host directory for downloaded media, bind-mounted to /app/bangumi in the
# scheduler/worker/api containers. Defaults to ./bangumi; point this at a
# separate disk/NAS mount if desired.
# DOWNLOAD_PATH=./bangumi

# Port for the web UI (nginx). Default 8080.
WEB_PORT=8080

# Mark the session cookie Secure (only sent over HTTPS). Defaults to "0"
# for the internal-HTTP docker-compose deployment (nginx does not
# terminate TLS by default). Set to "1" once the dashboard is served over
# HTTPS (direct TLS or a TLS-terminating reverse proxy in front of `web`).
ANIGAMERPLUS_HTTPS_ONLY=0

# Comma-separated allowlist of Origin header values accepted by the
# WebSocket endpoints (/api/ws/tasks_progress, /api/ws/logs). Defaults to
# the local Vite dev origins plus http://web (the nginx service name inside
# the compose network). Only needed if you front the dashboard with a
# custom domain.
# ANIGAMERPLUS_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://web

# Comma-separated allowlist of Origin header values accepted by the CORS
# middleware for ordinary (non-WebSocket) API requests. Defaults to the
# local Vite dev origins (see DashboardApp.DEFAULT_ALLOWED_ORIGINS in
# app/main.py) — does NOT include http://web by default, unlike
# ANIGAMERPLUS_WS_ALLOWED_ORIGINS above, so set this explicitly if the web
# UI is served from the nginx container rather than a local dev server.
# Must not be "*": CORS credentials are always enabled, and a wildcard
# origin combined with credentials is refused at startup.
# ANIGAMERPLUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://web

# Discord OAuth login allowlist. When BOTH are unset (default), ANY Discord
# user who completes OAuth is auto-provisioned as a 'downloader' role user.
# For public / semi-public deployments, restrict access by setting at least one:
#
#   ANIGAMERPLUS_DISCORD_ALLOWED_GUILDS=guild_id1,guild_id2
#   ANIGAMERPLUS_DISCORD_ALLOWED_USER_IDS=discord_user_id1,discord_user_id2
#
# The gate requires membership in at least one listed guild OR a listed
# user id. Warning logged on every OAuth callback when both are empty.

# WebSocket keepalive tuning (higher = more forgiving of slow clients / proxy hiccups)
# ANIGAMERPLUS_WS_PING_INTERVAL=30
# ANIGAMERPLUS_WS_PING_TIMEOUT=60

# Telegram User API (MTProto, via hydrogram) — per-Discord-user Telegram
# chat monitoring/downloading. App-level credentials, shared across every
# bound user; each user still authenticates their own account (QR or phone
# login) — nobody needs to visit my.telegram.org except the admin, once.
# Get one from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Root directory every TG User API download must resolve inside (a
# user-supplied watched-chat "save_path" override, or the default
# per-chat directory alike). Defaults to bangumi_dir (the same directory
# every other download path in the app writes into) when unset — only set
# this if you want TG downloads confined to their own dedicated tree
# instead. Mirrors bt-downloader's "landing-dir empty = use bangumi_dir"
# convention.
# ANIGAMERPLUS_TG_LANDING_ROOT=

# Per-user cap on concurrently in-flight Telegram downloads (e.g. a channel
# dumping many matching files at once). Defaults to 3.
# ANIGAMERPLUS_TG_MAX_CONCURRENT_DOWNLOADS_PER_USER=3

# Rate limit for GET /api/tg/session/qr-login/{login_token} — the frontend's
# QR-login poll loop, per user. Defaults to 30/minute (matches the
# frontend's 2s poll interval, with a little headroom).
# ANIGAMERPLUS_RATE_LIMIT_TG_LOGIN_POLL=30/minute

# Rate limit for the QR/phone-login 2FA-password and phone-code submit
# endpoints, per user. Tighter than ANIGAMERPLUS_RATE_LIMIT_TG_LOGIN (login
# start) since each submission is a code/password guess. Defaults to
# 10/minute.
# ANIGAMERPLUS_RATE_LIMIT_TG_LOGIN_SUBMIT=10/minute

# BT downloader post-landing remote status refresh interval (seconds).
# Re-polls Put.io for entries that already landed locally but whose remote
# copy hasn't been cleared yet, catching SEEDING -> COMPLETED transitions
# and externally-deleted transfers. Only takes effect when bt-downloader is
# enabled. Recommended range 60-3600 (not enforced). Defaults to 600 (10 min).
# ANIGAMERPLUS_BT_REMOTE_REFRESH_SECONDS=600

# Max rows checked per BT remote-status-refresh tick (see above). Rows are
# ordered newest-landed first; a backlog beyond this cap is picked up on
# later ticks once the newest rows clear. Defaults to 100.
# ANIGAMERPLUS_BT_REMOTE_REFRESH_BATCH=100

# BT/TG progress reconcile: how old a row must be (hours) before its stuck
# ProgressBus entry is treated as a stale ghost and force-finished.
ANIGAMERPLUS_BT_STALE_GHOST_HOURS=1

# Fernet key used to encrypt Telegram User API session strings at rest
# (tg_session.session_string_encrypted). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only if the Telegram User API feature (TG_API_ID/TG_API_HASH) is
# configured. Rotating this key invalidates every stored session — users
# would need to re-bind.
ANIGAMERPLUS_FERNET_KEY=
